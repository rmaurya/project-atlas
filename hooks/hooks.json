{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-commit.sh\"; if [ -r \"$S\" ]; then sh \"$S\"; else payload=$(cat); printf '%s' \"$payload\" | grep -qE '(^|[^[:alnum:]_./-])git[[:space:]]+commit' || exit 0; M=\"project-atlas: the commit guard is not readable at $S, so this commit was NOT checked. That is a half-installed plugin, not a problem with the commit — it warns rather than refusing, because a broken guard must not stop other people's work in repositories that may never have adopted this tool.\"; echo \"$M\" >&2; printf '{\"systemMessage\":\"%s\",\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"%s\"}}\\n' \"$M\" \"$M\"; exit 0; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-session-start.sh\"; [ -r \"$S\" ] && sh \"$S\"; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-write.sh\"; [ -r \"$S\" ] && sh \"$S\"; exit 0"
          }
        ]
      },
      {
        "matcher": "TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-task.sh\"; [ -r \"$S\" ] && sh \"$S\"; exit 0"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-activity.sh\"; [ -r \"$S\" ] && sh \"$S\"; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-continuity.sh\"; [ -r \"$S\" ] && sh \"$S\" stop; exit 0"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-continuity.sh\"; [ -r \"$S\" ] && sh \"$S\" subagent; exit 0"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-continuity.sh\"; [ -r \"$S\" ] && sh \"$S\" precompact; exit 0"
          }
        ]
      }
    ]
  }
}
