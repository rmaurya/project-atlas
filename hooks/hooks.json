{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-commit.sh\"; if [ -r \"$S\" ]; then sh \"$S\"; else payload=$(cat); printf '%s' \"$payload\" | grep -qE '(^|[^[:alnum:]_./-])git[[:space:]]+commit' || exit 0; echo \"project-atlas: the commit guard is not readable at $S. This commit was NOT checked.\" >&2; exit 2; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-session-start.sh\"; [ -r \"$S\" ] && sh \"$S\"; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-write.sh\"; [ -r \"$S\" ] && sh \"$S\"; exit 0"
          }
        ]
      },
      {
        "matcher": "TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-task.sh\"; [ -r \"$S\" ] && sh \"$S\"; exit 0"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-activity.sh\"; [ -r \"$S\" ] && sh \"$S\"; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-continuity.sh\"; [ -r \"$S\" ] && sh \"$S\" stop; exit 0"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-continuity.sh\"; [ -r \"$S\" ] && sh \"$S\" subagent; exit 0"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/hooks/on-continuity.sh\"; [ -r \"$S\" ] && sh \"$S\" precompact; exit 0"
          }
        ]
      }
    ]
  }
}
